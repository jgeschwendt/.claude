{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 3650,
  "defaultToAgentsView": true,
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "claude-fable-5[1m]",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/memory-recall.js",
            "timeout": 10,
            "statusMessage": "recalling memories..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/.orrery/bin/orrery\" ] && exec \"$HOME/.orrery/bin/orrery\" observe || exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/format.js",
            "statusMessage": "formatting..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/.orrery/bin/orrery\" ] && exec \"$HOME/.orrery/bin/orrery\" observe || exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/.orrery/bin/orrery\" ] && exec \"$HOME/.orrery/bin/orrery\" snapshot || exit 0",
            "timeout": 30,
            "statusMessage": "routing the pre-compact conversation..."
